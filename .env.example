# Copy to .env and adjust as needed. Values here match docker-compose defaults.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=labflow
POSTGRES_USER=labflow
POSTGRES_PASSWORD=labflow
POSTGRES_POOL_MAX=10
POSTGRES_IDLE_TIMEOUT_MS=30000
POSTGRES_CONNECTION_TIMEOUT_MS=5000

# --- RabbitMQ ---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=labflow
RABBITMQ_PASSWORD=labflow
RABBITMQ_VHOST=/

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Auth ---
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=8h

# --- External laboratory integration (fake provider, see cmd/externallab) ---
EXTERNAL_LAB_BASE_URL=http://localhost:4000
EXTERNAL_LAB_PORT=4000
EXTERNAL_LAB_WEBHOOK_SECRET=change-me-shared-secret
LABFLOW_WEBHOOK_URL=http://localhost:3000/webhooks/laboratory/results

# --- Reliability tuning ---
IDEMPOTENCY_KEY_TTL_SECONDS=86400
OUTBOX_RELAY_INTERVAL_MS=1000
CIRCUIT_BREAKER_TIMEOUT_MS=5000
CIRCUIT_BREAKER_ERROR_THRESHOLD=50
CIRCUIT_BREAKER_RESET_TIMEOUT_MS=15000
