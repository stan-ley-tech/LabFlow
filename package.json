{
  "name": "labflow",
  "version": "0.1.0",
  "description": "Laboratory workflow backend for managing lab orders from clinician request through result validation and delivery.",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "cmd/server/index.js",
  "scripts": {
    "start": "node cmd/server/index.js",
    "start:worker": "node cmd/worker/index.js",
    "start:externallab": "node cmd/externallab/index.js",
    "dev": "nodemon cmd/server/index.js",
    "dev:worker": "nodemon cmd/worker/index.js",
    "migrate": "node internal/db/migrate.js up",
    "migrate:down": "node internal/db/migrate.js down",
    "seed": "node internal/db/seed.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "jest --runInBand",
    "test:unit": "jest tests/unit --runInBand",
    "test:integration": "jest tests/integration --runInBand",
    "test:api": "jest tests/api --runInBand",
    "test:webhooks": "jest tests/webhooks --runInBand",
    "test:e2e": "jest tests/e2e --runInBand"
  },
  "dependencies": {
    "amqplib": "^0.10.4",
    "axios": "^1.7.7",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "opossum": "^8.1.4",
    "pg": "^8.13.0",
    "pino": "^9.4.0",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "prettier": "^3.3.3",
    "supertest": "^7.0.0"
  }
}
